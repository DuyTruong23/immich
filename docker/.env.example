# Immich backend — local development
# Copy: cp docker/.env.example docker/.env
# Docs: https://docs.immich.app/install/docker-compose

# Pin version — không dùng latest trên production
IMMICH_VERSION=release

# Upload storage (relative to docker/ directory)
UPLOAD_LOCATION=./data/upload

# Database storage
DB_DATA_LOCATION=./data/postgres

# Database credentials — đổi trước khi deploy production
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich

# Optional: timezone
TZ=UTC

# Optional: public URL (for OAuth callbacks in production)
# IMMICH_PUBLIC_URL=http://localhost:2283
